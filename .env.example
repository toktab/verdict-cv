APP_PORT=8080

MYSQL_DATABASE=verdict
MYSQL_USER=verdict
MYSQL_PASSWORD=change_me_verdict_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
VERDICT_RABBITMQ_ENABLED=false
VERDICT_RABBITMQ_EXCHANGE=verdict.events

VERDICT_ADMIN_USERNAME=admin
VERDICT_ADMIN_PASSWORD=change_me_admin_password
VERDICT_ALLOW_DEFAULT_ADMIN=false
VERDICT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
VERDICT_RATE_LIMIT_ENABLED=true
VERDICT_RATE_LIMIT_WINDOW_SECONDS=60
VERDICT_RATE_LIMIT_AUTH_REQUESTS=10
VERDICT_RATE_LIMIT_AUDIT_REQUESTS=20
VERDICT_RATE_LIMIT_ADMIN_REQUESTS=60

VERDICT_LLM_API_KEY=
VERDICT_LLM_MODEL=gpt-4o-mini
VERDICT_LLM_TEMPERATURE=0.2
VERDICT_LLM_URL=https://api.openai.com/v1/chat/completions

VERDICT_MAX_CLAIM_CHARS=12000
VERDICT_MAX_EVIDENCE_CHARS=20000
VERDICT_MAX_SENTENCES=60
