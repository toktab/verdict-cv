    "riskyWords": [
      "expert",
      "senior",
      "led",
      "advanced",
      "proven",
      "guaranteed",
      "best",
      "deep"
    ],
    "localAuditRiskyWords": [
      "expert",
      "advanced",
      "proven",
      "led",
      "optimized",
      "guaranteed",
      "best",
      "senior"
    ],
    "techTerms": [
