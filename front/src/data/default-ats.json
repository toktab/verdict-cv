      "label": "CREDENTIAL_CLAIM",
      "category": "Education and credentials",
      "risk": "High",
      "why": "Degrees, licenses, awards, and certifications are verifiable credential claims.",
      "safer": "Add issuer, institution, field, date, credential ID, transcript, or verification link.",
