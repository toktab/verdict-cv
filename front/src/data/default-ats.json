    {
      "id": "skill-depth",
      "label": "SKILL_DEPTH_CLAIM",
      "category": "Skill-depth phrases",
      "risk": "High",
      "why": "Skill-depth wording can overstate ability if it is not tied to evidence.",
      "safer": "Replace vague depth wording with the exact task, project, duration, or artifact.",
      "keywords": [
        "Commercial experience with",
        "Production experience with",
        "Professional experience with",
        "Deep understanding of",
        "Excellent knowledge of",
        "Advanced knowledge of",
        "Proficient in",
        "Highly proficient in",
        "Expert in",
        "Specialist in",
        "Mastery of",
        "Strong command of",
        "End-to-end experience",
        "Full lifecycle experience",
        "Enterprise-level experience",
        "Industry experience"
      ]
    },
    {
      "id": "vague-skill-depth",
      "label": "VAGUE_CLAIM",
      "category": "Vague skill-depth phrases",
      "risk": "Medium",
      "why": "These phrases are common but do not explain what the person actually did.",
      "safer": "Add a project, task, timeframe, or concrete example.",
      "keywords": [
        "Familiar with",
        "Some experience with",
        "Working knowledge of",
        "Practical knowledge of",
        "Practical experience with",
        "Hands-on experience with",
        "Strong understanding of",
        "Solid understanding of",
        "Good knowledge of",
        "Experienced in",
        "Skilled in",
        "Able to work with",
        "Capable of",
        "Confident in",
        "Cross-functional experience",
        "Real-world experience"
      ]
    },
    {
      "id": "responsibility-verbs",
      "label": "LEADERSHIP_CLAIM",
      "category": "Responsibility verbs",
      "risk": "High",
      "why": "Ownership, leadership, architecture, deployment, and security verbs imply responsibility.",
      "safer": "Add scope, team size, decision authority, diagrams, release notes, or before/after evidence.",
      "keywords": [
        "Built from scratch",
        "Designed",
        "Architected",
        "Led",
        "Co-led",
