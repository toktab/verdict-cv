    {
      "id": "security-concepts",
      "label": "TECH_SKILL_CLAIM",
      "category": "Security concepts",
      "risk": "High",
      "why": "Security claims are sensitive and should not be trusted without implementation details or reports.",
      "safer": "Specify flow, controls, hashing method, roles, legal testing scope, report, or deployment evidence.",
      "keywords": [
        "JWT",
        "OAuth2",
        "OpenID Connect",
        "RBAC",
        "Encryption",
        "Hashing",
        "bcrypt",
        "HTTPS",
