    {
      "id": "contact-profile-fields",
      "label": "CONTACT_FIELD",
      "category": "Contact and profile fields",
      "risk": "Low",
      "why": "Profile/contact fields help verification but may include sensitive data.",
      "safer": "Validate links and avoid unnecessary sensitive personal information.",
      "keywords": [
        "Email",
        "Phone",
        "Mobile",
        "LinkedIn",
        "Location",
        "Address",
        "Remote availability",
        "Languages",
        "English – Fluent",
        "English – B2",
        "Citizenship",
        "Work permit",
        "Visa sponsorship",
        "Availability",
        "Notice period",
        "Salary expectation",
        "References",
        "Date of birth",
        "Marital status",
        "Photo"
      ]
    },
    {
      "id": "job-promises",
      "label": "JOB_PROMISE",
      "category": "Job-posting promises",
      "risk": "High",
      "why": "Compensation, benefits, remote work, legal, and growth promises affect candidate decisions.",
      "safer": "Clarify exact amount, policy, range, schedule, restrictions, eligibility, or conditions.",
      "keywords": [
        "Competitive salary",
        "Attractive salary",
        "Salary negotiable",
        "Paid training",
        "Flexible schedule",
        "Flexible hours",
        "Remote work",
        "Work from anywhere",
        "Full benefits package",
        "Health insurance",
        "Paid vacation",
        "Bonus",
        "Annual bonus",
        "Performance bonus",
        "Stock options",
        "Equity",
        "Relocation support",
        "Visa sponsorship",
        "Learning budget",
        "Conference budget",
        "Paid internship",
        "Unpaid internship",
        "Trial period",
        "Probation period",
        "No overtime",
        "Industry leader"
      ]
    },
    {
      "id": "quantified-claims",
      "label": "QUANTIFIED_CLAIM",
      "category": "Quantified claims",
      "risk": "High",
      "why": "Numbers, money, percentages, years, users, latency, team size, and scale claims need a source.",
      "safer": "Add source, before/after, formula, date range, benchmark, logs, analytics, or salary terms.",
      "patterns": [
        "\\b\\d+(?:\\.\\d+)?%",
        "\\b\\d+\\+?\\s*(?:years?|yrs?|months?|weeks?)\\b",
        "\\bteam of \\d+\\b",
        "\\bmanaged \\d+\\b",
        "\\b\\d+\\+?\\s*(?:users?|customers?|clients?|projects?|features?|APIs?|endpoints?|test cases?|bug reports?|tickets?|commits?|pull requests?|deployments?|releases?|microservices?|databases?|servers?)\\b",
        "\\b\\d+\\+?\\s*(?:RPS|ms|seconds?|minutes?)\\b",
        "\\b\\d+\\+?\\s*(?:GEL|USD|EUR)\\b",
        "[$€₾][\\d,]+",
        "\\b\\d+[kM]\\b",
        "\\b\\d+x\\b",
        "\\b\\d+ times faster\\b",
        "\\bunder \\d+ ms\\b",
        "\\b99\\.9% uptime\\b",
        "\\b24/7\\b",
        "\\bup to \\d+%\\b",
        "\\bstarting from\\b.*\\d+"
      ]
    },
    {
      "id": "mismatch-rules",
      "label": "POSSIBLE_MISMATCH",
      "category": "Cross-category mismatch",
      "risk": "High",
      "why": "Seniority, skill depth, and responsibility claims may contradict each other.",
      "safer": "Clarify true level or replace inflated wording with accurate scope.",
      "patterns": [
        "\\bjunior\\b.*\\bexpert\\b",
        "\\bentry[- ]level\\b.*\\b5\\+?\\s*years\\b",
        "\\bintern\\b.*\\b(?:owned|led|architected)\\b",
        "\\bsenior\\b.*\\bbasic knowledge\\b",
        "\\blead\\b.*\\bteam of \\d+\\b",
        "\\barchitect\\b.*\\bno design evidence\\b",
        "\\bproduction experience\\b.*\\b(?:no project|no evidence)\\b"
      ]
    }
  ]
