  "rules": [
    {
      "id": "seniority-levels",
      "label": "SENIORITY_CLAIM",
      "category": "Seniority levels",
      "risk": "High",
      "why": "Seniority, leadership, and level titles can materially affect hiring decisions.",
      "safer": "Add years, role scope, project ownership, leadership evidence, architecture decisions, or team size.",
      "keywords": [
        "Senior",
        "Senior Developer",
        "Senior Software Engineer",
        "Lead",
        "Team Lead",
        "Technical Lead",
        "Lead Developer",
        "Principal",
        "Principal Engineer",
        "Staff Engineer",
        "Manager",
        "Engineering Manager",
        "Project Manager",
        "Product Manager",
        "Head of",
        "Head of Engineering",
        "Architect",
        "Software Architect",
        "Solution Architect",
        "Cloud Architect",
        "Enterprise Architect",
        "Expert",
        "Expert Java Developer"
      ]
    },
    {
      "id": "junior-levels",
      "label": "SENIORITY_CLAIM",
      "category": "Seniority levels",
      "risk": "Medium",
      "why": "Junior, mid-level, trainee, and associate labels should match the claimed responsibility level.",
      "safer": "Clarify expected responsibilities, stack, years, mentorship level, and project scope.",
      "keywords": [
        "Junior",
        "Junior Developer",
        "Junior QA Engineer",
        "Junior Java Developer",
        "Mid-level",
        "Mid-level Developer",
        "Middle Developer",
        "Middle QA Engineer",
        "Entry-level",
        "Entry-level Developer",
        "Associate",
        "Associate Engineer",
        "Trainee",
        "Graduate Trainee",
        "Specialist",
        "QA Specialist"
      ]
    },
    {
      "id": "technical-languages",
      "label": "TECH_SKILL_CLAIM",
      "category": "Technical skills",
      "risk": "Medium",
      "why": "Technology names are broad skill claims unless they are tied to real tasks or projects.",
      "safer": "Add project, repository, endpoint, tests, deployment, schema, or role evidence.",
      "keywords": [
        "Java",
        "Python",
        "JavaScript",
        "TypeScript",
        "C#",
