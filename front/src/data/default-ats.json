      ]
    },
    {
      "id": "impact-phrases",
      "label": "IMPACT_CLAIM",
      "category": "Achievement and impact phrases",
      "risk": "High",
      "why": "Performance, revenue, reliability, scale, and maturity claims need measurement.",
      "safer": "Add source, baseline, timeframe, benchmark, analytics, monitoring, or calculation.",
      "keywords": [
        "Increased",
        "Increased revenue",
        "Increased conversion",
        "Increased user engagement",
        "Increased retention",
        "Reduced",
        "Reduced costs",
        "Reduced bugs",
        "Reduced latency",
        "Reduced load time",
        "Improved performance",
        "Improved reliability",
        "Improved security",
